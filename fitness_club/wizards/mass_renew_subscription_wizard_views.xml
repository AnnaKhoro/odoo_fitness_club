<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_mass_renew_subscription_wizard_form"
            model="ir.ui.view">
        <field name="name">mass.renew.subscription.wizard.form</field>
        <field name="model">mass.renew.subscription.wizard</field>
        <field name="arch" type="xml">
            <form string="Mass renew subscription">
                <group>
                    <field name="plan_id"/>
                    <field name="date_start"/>
                </group>
                <footer>
                    <button name="action_apply" type="object"
                            string="Apply" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mass_renew_subscription_wizard"
            model="ir.actions.act_window">
        <field name="name">Mass renew subscription</field>
        <field name="res_model">mass.renew.subscription.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_fitness_member"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
