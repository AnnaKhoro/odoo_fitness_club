<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_attendance_report_wizard_form"
            model="ir.ui.view">
        <field name="name">attendance.report.wizard.form</field>
        <field name="model">attendance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Attendance report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="member_ids"
                               widget="many2many_tags"/>
                        <field name="trainer_ids"
                               widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate" type="object"
                            string="Generate report"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_attendance_report_wizard_member"
            model="ir.actions.act_window">
        <field name="name">Attendance report</field>
        <field name="res_model">attendance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_fitness_member"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <record id="action_attendance_report_wizard_trainer"
            model="ir.actions.act_window">
        <field name="name">Attendance report</field>
        <field name="res_model">attendance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_fitness_trainer"/>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
