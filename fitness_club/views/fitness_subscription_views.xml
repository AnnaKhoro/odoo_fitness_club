<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_fitness_subscription_tree" model="ir.ui.view">
        <field name="name">fitness.subscription.tree</field>
        <field name="model">fitness.subscription</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'"
                  decoration-warning="state == 'expired'"
                  decoration-muted="state == 'cancelled'">
                <field name="member_id"/>
                <field name="plan_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="days_left"/>
                <field name="visits_used"/>
                <field name="price"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_subscription_form" model="ir.ui.view">
        <field name="name">fitness.subscription.form</field>
        <field name="model">fitness.subscription</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,expired,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="plan_id"/>
                            <field name="price" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end" readonly="1"/>
                            <field name="days_left" readonly="1"/>
                            <field name="visits_used" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fitness_subscription_search" model="ir.ui.view">
        <field name="name">fitness.subscription.search</field>
        <field name="model">fitness.subscription</field>
        <field name="arch" type="xml">
            <search>
                <field name="member_id"/>
                <field name="plan_id"/>
                <filter name="active" string="Active"
                        domain="[('state', '=', 'active')]"/>
                <filter name="expired" string="Expired"
                        domain="[('state', '=', 'expired')]"/>
                <filter name="cancelled" string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
                <filter name="group_plan" string="Plan"
                        context="{'group_by': 'plan_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_fitness_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">fitness.subscription</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
