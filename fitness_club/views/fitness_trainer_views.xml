<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_fitness_trainer_tree" model="ir.ui.view">
        <field name="name">fitness.trainer.tree</field>
        <field name="model">fitness.trainer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="specialization"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="user_id"/>
                <field name="class_count"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_trainer_form" model="ir.ui.view">
        <field name="name">fitness.trainer.form</field>
        <field name="model">fitness.trainer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="specialization"/>
                            <field name="user_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="class_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Classes">
                            <field name="class_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="start_datetime"/>
                                    <field name="participant_count"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitness_trainer" model="ir.actions.act_window">
        <field name="name">Trainers</field>
        <field name="res_model">fitness.trainer</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
