<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_fitness_attendance_tree" model="ir.ui.view">
        <field name="name">fitness.attendance.tree</field>
        <field name="model">fitness.attendance</field>
        <field name="arch" type="xml">
            <list>
                <field name="attended_on"/>
                <field name="member_id"/>
                <field name="class_id"/>
                <field name="subscription_id"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_attendance_form" model="ir.ui.view">
        <field name="name">fitness.attendance.form</field>
        <field name="model">fitness.attendance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="member_id"/>
                        <field name="class_id"/>
                        <field name="attended_on"/>
                        <field name="subscription_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fitness_attendance_pivot" model="ir.ui.view">
        <field name="name">fitness.attendance.pivot</field>
        <field name="model">fitness.attendance</field>
        <field name="arch" type="xml">
            <pivot string="Attendances" sample="1">
                <field name="class_id" type="row"/>
                <field name="attended_on" interval="month" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_fitness_attendance_graph" model="ir.ui.view">
        <field name="name">fitness.attendance.graph</field>
        <field name="model">fitness.attendance</field>
        <field name="arch" type="xml">
            <graph string="Attendances" type="bar" stacked="1" sample="1">
                <field name="attended_on" interval="month"/>
                <field name="member_id"/>
            </graph>
        </field>
    </record>

    <record id="action_fitness_attendance" model="ir.actions.act_window">
        <field name="name">Attendances</field>
        <field name="res_model">fitness.attendance</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

</odoo>
