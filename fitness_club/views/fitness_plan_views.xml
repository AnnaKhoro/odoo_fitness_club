<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_fitness_plan_tree" model="ir.ui.view">
        <field name="name">fitness.plan.tree</field>
        <field name="model">fitness.plan</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="duration_days"/>
                <field name="price"/>
                <field name="max_visits"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_plan_form" model="ir.ui.view">
        <field name="name">fitness.plan.form</field>
        <field name="model">fitness.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="duration_days"/>
                            <field name="max_visits"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fitness_plan_search" model="ir.ui.view">
        <field name="name">fitness.plan.search</field>
        <field name="model">fitness.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="unlimited" string="Unlimited visits"
                        domain="[('max_visits', '=', 0)]"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_fitness_plan" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">fitness.plan</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
