<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="paperformat_member_a4" model="report.paperformat">
        <field name="name">Member card A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_member" model="ir.actions.report">
        <field name="name">Member Card</field>
        <field name="model">fitness.member</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fitness_club.report_member_template</field>
        <field name="report_file">fitness_club.report_member_template</field>
        <field name="paperformat_id" ref="paperformat_member_a4"/>
        <field name="binding_model_id" ref="model_fitness_member"/>
        <field name="binding_view_types">list,form</field>
        <field name="print_report_name">'Member card - %s' % object.name</field>
    </record>

</odoo>
